// Cloudflare Worker for the scanner (worker/send-scan.js). Cloudflare deploys it from this repo
// on every push to main. "name" must match the project name in the Cloudflare dashboard.
// The KV namespace for SCANS is created on the first deploy (wrangler 4.45+ provisions bindings without an id).
// The bot token is not here: it is the secret BOT_TOKEN, set in the dashboard.
{
  "name": "d-simya",
  "main": "worker/send-scan.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "SCANS" }],
  // Workers AI translates scanned pages (free plan: 10 000 neurons a day)
  "ai": { "binding": "AI" },
  // The family shopping list: one Durable Object per list (SQLite storage, available on the free plan)
  "durable_objects": { "bindings": [{ "name": "LISTS", "class_name": "ShoppingList" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShoppingList"] }],
  // One cron every 30 minutes runs every job; each job checks the time in Xanten itself and sends at most once:
  // waste at 18:00, flyers on Mondays at 08:00, the word of the day at 09:00, DWD warnings whenever there are new ones,
  // each person's morning digest at their half hour (06:00–09:00), and checks that the services the app needs still answer.
  // (The free plan allows 5 crons per account, shared by all Workers: this one uses a single one.)
  "triggers": { "crons": ["*/30 * * * *"] }
}
