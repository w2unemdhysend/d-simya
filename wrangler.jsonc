// Cloudflare Worker for the scanner (worker/send-scan.js). Cloudflare deploys it from this repo
// on every push to main. "name" must match the project name in the Cloudflare dashboard.
// The KV namespace for SCANS is created on the first deploy (wrangler 4.45+ provisions bindings without an id).
// The bot token is not here: it is the secret BOT_TOKEN, set in the dashboard.
// Who may use the bot: worker/config.js (FAMILY); more people without a code change: the secret ALLOWED_USERS.
{
  "name": "d-simya",
  "main": "worker/send-scan.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // settings made in the dashboard stay after a deploy from the repo
  "keep_vars": true,
  // Every deploy (wrangler deploy, also Cloudflare's own build on a push) first runs the server's tests, about 1 s:
  // if one fails, nothing is deployed and the Worker that runs now stays (the same list: npm run test:worker)
  "build": { "command": "node tools/test.mjs access bot features transit worker", "watch_dir": "worker" },
  "kv_namespaces": [{ "binding": "SCANS" }],
  // Workers AI translates scanned pages (free plan: 10 000 neurons a day)
  "ai": { "binding": "AI" },
  // The family shopping list: one Durable Object per list (SQLite storage, available on the free plan)
  "durable_objects": { "bindings": [{ "name": "LISTS", "class_name": "ShoppingList" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShoppingList"] }],
  // The public endpoints that reach OSRM or VRR on every call (walking routes, stops near me): at most 30 a minute
  // per address across Cloudflare (worker/transit.js also keeps a cap per Worker instance, binding or not)
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // One cron every 30 minutes runs every job; each job checks the time in Xanten itself:
  // waste from 18:00, flyers on Mondays from 08:00, the word of the day from 09:00, DWD warnings whenever there are new
  // ones, each person's morning digest at their half hour (06:00–09:00), and checks that the services the app needs
  // still answer. Each person is marked once Telegram took their message; whoever was missed gets it on the next run.
  // (The free plan allows 5 crons per account, shared by all Workers: this one uses a single one.)
  "triggers": { "crons": ["*/30 * * * *"] }
}
